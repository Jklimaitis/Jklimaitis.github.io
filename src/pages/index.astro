---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/manrope';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
---


<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Portfólio · Jonas Klimaitis</title>
  </head>
  <body>
    <header>
      <nav aria-label="Seções">
        <a href="#inicio">Início</a>
        <a href="#stack">Stack</a>
        <a href="#projetos">Projetos</a>
        <a href="#github">GitHub</a>
        <a href="#trajetoria">Trajetória</a>
        <a href="#contato">Contato</a>
      </nav>
    </header>

    <main>
      <section id="inicio">
        <h1>Jonas Klimaitis</h1>
        <p class="lead">Backend em Python, com foco em automação e integração de sistemas.</p>
        <div class="ctas">
          <a class="cta cta--primary" href="#projetos">Ver projetos</a>
          <a class="cta cta--ghost" href="https://github.com/Jklimaitis">GitHub</a>
        </div>
      </section>

      <section id="stack">
        <h2>Com o que eu trabalho</h2>
        <div class="stack">
          <div class="stack__grupo">
            <h3>Backend</h3>
            <p>Python, FastAPI, Django, APIs REST, JWT com refresh, bcrypt com pepper</p>
          </div>
          <div class="stack__grupo">
            <h3>Arquitetura</h3>
            <p>Arquitetura em camadas, SOLID, Clean Code, serviços desacoplados</p>
          </div>
          <div class="stack__grupo">
            <h3>Dados</h3>
            <p>PostgreSQL, MySQL, Oracle, SQL, modelagem relacional</p>
          </div>
          <div class="stack__grupo">
            <h3>Infra e DevOps</h3>
            <p>Docker, Linux (WSL e Ubuntu), Git e GitHub, systemd, nginx, Proxmox</p>
          </div>
          <div class="stack__grupo">
            <h3>Testes e qualidade</h3>
            <p>pytest, testes de API, revisão de código, verificação por execução</p>
          </div>
          <div class="stack__grupo">
            <h3>Outras linguagens</h3>
            <p>Java, JavaScript, Node.js, React, Bash</p>
          </div>
          <div class="stack__grupo">
            <h3>Automação e IA</h3>
            <p>Automação de processos, integração via APIs, orquestração de agentes, multi-agente em Slack, LLM como ferramenta de engenharia</p>
          </div>
          <div class="stack__grupo stack__grupo--estudando">
            <h3>Estudando</h3>
            <p>OAuth2, MongoDB, AWS, microsserviços, TDD, UiPath</p>
          </div>
        </div>
      </section>

      <section id="projetos">
        <h2>Projetos</h2>
        <p>Em construção.</p>
      </section>

      <section id="github">
        <h2>Atividade no GitHub</h2>
        <p>Em construção.</p>
      </section>

      <section id="trajetoria">
        <h2>Trajetória</h2>
        <p>Em construção.</p>
      </section>

      <section id="contato">
        <h2>Contato</h2>
        <p>Em construção.</p>
      </section>
    </main>

    <footer>
      <p>Portfólio de Jonas Klimaitis.</p>
    </footer>
  </body>
</html>