---
import Moldura from '../../../components/Moldura.astro';
import CasosLista from '../../../components/CasosLista.astro';
import { casosEn } from '../../../dados/casos.mts';

const descricao =
  'Technical cases: architecture decisions, what broke in production, and how delivery was verified.';
---

<Moldura
  idioma="en"
  titulo="Cases"
  descricao={descricao}
  marca="Jonas Klimaitis"
  voltar={{ href: '/en/', rotulo: 'Back to portfolio' }}
  troca={{
    href: '/casos/',
    rotulo: 'PT',
    rotuloAcessivel: 'Ler os casos em português',
  }}
>
  <header class="cabeca">
    <h1>Cases</h1>
    <p class="lead">{descricao}</p>
  </header>

  <CasosLista casos={casosEn} rotuloAcao="Read the case" />
</Moldura>

<style>
  .cabeca {
    padding-bottom: 1.5rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
  }

  h1 {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .lead {
    margin: 0;
    color: var(--muted);
  }
</style>
