---
import Moldura from './Moldura.astro';
import CasoDiagrama from './CasoDiagrama.astro';
import type { Caso } from '../dados/caso-multiagente.mts';

interface Props {
  caso: Caso;
}

const { caso } = Astro.props;
---

<Moldura
  idioma={caso.idioma}
  titulo={caso.titulo}
  descricao={caso.lead}
  marca={caso.marca}
  voltar={caso.voltar}
  troca={caso.troca}
>
  <article>
    <header class="cabeca">
      <h1>{caso.titulo}</h1>
      <p class="lead">{caso.lead}</p>
      <ul class="meta">
        {caso.meta.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </header>

    {caso.blocos.map((bloco) => (
      <section class="bloco">
        <h2>{bloco.titulo}</h2>
        {bloco.paragrafos.map((texto) => (
          <p>{texto}</p>
        ))}
        {bloco.diagrama && <CasoDiagrama idioma={caso.idioma} />}
        {bloco.lista && (
          <dl class="itens">
            {bloco.lista.map((item) => (
              <div>
                <dt>{item.titulo}</dt>
                <dd>{item.texto}</dd>
              </div>
            ))}
          </dl>
        )}
      </section>
    ))}

    <aside class="fecho">
      <h2>{caso.fecho.titulo}</h2>
      <p>{caso.fecho.texto}</p>
    </aside>
  </article>
</Moldura>

<style>
  .cabeca {
    padding-bottom: 2rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--line);
  }

  h1 {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 2.875rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .lead {
    margin: 0 0 1.5rem;
    max-width: 38rem;
    color: var(--fg);
    opacity: 0.86;
    font-size: 1.0625rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .meta li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--fg);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 0.25rem 0.625rem;
  }

  .bloco {
    margin-bottom: 2.75rem;
  }

  h2 {
    position: relative;
    margin: 0 0 0.875rem;
    padding-left: 0.85rem;
    font-family: var(--font-display);
    font-size: 1.3125rem;
    line-height: 1.25;
  }

  h2::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.35em;
    width: 3px;
    height: 0.85em;
    background: var(--accent);
    border-radius: 2px;
  }

  p {
    margin: 0 0 1rem;
  }

  .itens {
    margin: 0;
    display: grid;
    gap: 1.25rem;
  }

  .itens div {
    border-left: 2px solid var(--line-strong);
    padding-left: 1rem;
  }

  dt {
    margin-bottom: 0.25rem;
    font-weight: 700;
  }

  dd {
    margin: 0;
    color: var(--muted);
  }

  .fecho {
    margin-top: 3rem;
    padding: 1.5rem;
    border: 1px solid var(--line-strong);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .fecho h2 {
    padding-left: 0;
    font-size: 1.125rem;
  }

  .fecho h2::before {
    content: none;
  }

  .fecho p {
    margin: 0;
    color: var(--muted);
  }
</style>
