---
import Commits from './Commits.astro';
import type { Dicionario } from '../i18n/types';

interface Props {
  d: Dicionario;
}

const { d } = Astro.props;
---

<section id="github">
  <h2 data-revelar>{d.github.titulo}</h2>

  <p class="github__fonte">{d.github.fonte}</p>

  <div class="resumo">
    <div class="resumo__lado">
      <p class="resumo__total">
        <strong data-total>—</strong>
        <span>{d.github.indicadores.contribuicoes}</span>
      </p>
      <Commits />
    </div>
    <dl class="indicadores" data-indicadores hidden></dl>
  </div>

  <p data-papel="fallback">
    {d.github.fallback}
    <a
      href="https://github.com/Jklimaitis"
      rel="noopener noreferrer"
      target="_blank"
    >
      {d.github.linkPerfil}
    </a>
  </p>

  <div data-bloco="calendario" aria-busy="true" hidden>
    <p data-papel="estado">{d.github.carregando}</p>
  </div>

  <div data-bloco="repositorios" aria-busy="true" hidden>
    <div class="bloco__cabeca">
      <h3 class="bloco__rotulo">{d.github.recentes}</h3>
      <a
        class="bloco__link"
        href="https://github.com/Jklimaitis"
        rel="noopener noreferrer"
        target="_blank"
      >
        {d.github.verTodos}
      </a>
    </div>
    <p data-papel="estado">{d.github.carregando}</p>
  </div>
</section>

<script>
  import { alinharSemana, calcularIndicadores } from '../dados/calendario.mts';
  import type { Dia } from '../dados/tipos.mts';
  import { chaveCache, lerCache } from '../dados/cache.mts';
  import { formatarMesAno } from '../dados/formato.mts';
  import { seloDeDiferenca } from '../dados/motion.mts';
  import { dadosDaSessao } from '../dados/sessao.mts';
  import { en } from '../i18n/en';
  import { pt } from '../i18n/pt';

  const textos = document.documentElement.lang.startsWith('en') ? en : pt;
  const t = textos.github;

  const secao = document.getElementById('github');
  if (!secao) throw new Error('secao github ausente');

  const buscarBloco = (nome: string) =>
    secao.querySelector<HTMLElement>(`[data-bloco="${nome}"]`);

  function iniciar(nome: string): HTMLElement | null {
    const el = buscarBloco(nome);
    if (!el) return null;
    el.removeAttribute('hidden');
    el.setAttribute('aria-busy', 'true');
    const estado = el.querySelector('[data-papel="estado"]');
    if (estado) estado.remove();
    return el;
  }

  function concluir(el: HTMLElement) {
    el.setAttribute('aria-busy', 'false');
  }

  function aviso(el: HTMLElement, texto: string) {
    const p = document.createElement('p');
    p.className = 'github__aviso';
    p.textContent = texto;
    el.append(p);
  }

  function textoFalha(motivo: string): string {
    return motivo === 'limite' ? t.limite : t.indisponivel;
  }

  secao.querySelector('[data-papel="fallback"]')?.setAttribute('hidden', '');

  const reduzido = window.matchMedia(
    '(prefers-reduced-motion: reduce)',
  ).matches;

  // Estado da visita anterior, lido antes de o cache ser sobrescrito.
  const chaveAnterior = chaveCache('calendario', 'Jklimaitis');
  const anterior = lerCache<Dia[]>(
    window.localStorage,
    chaveAnterior,
    Date.now(),
    Number.MAX_SAFE_INTEGER,
  );
  const indicadoresAnteriores =
    anterior.estado === 'valido' ? calcularIndicadores(anterior.dados) : null;

  const repos = iniciar('repositorios');
  const calendario = iniciar('calendario');

  const estado = await dadosDaSessao({
    buscar: window.fetch.bind(window),
    armazenamento: window.localStorage,
    agora: () => Date.now(),
  });

  if (repos) {
    if (!estado.repositorios.ok) {
      aviso(repos, textoFalha(estado.repositorios.motivo));
    } else if (estado.repositorios.dados.itens.length === 0) {
      aviso(repos, t.listaVazia);
    } else {
      const grade = document.createElement('div');
      grade.className = 'cartoes';

      for (const item of estado.repositorios.dados.itens) {
        const artigo = document.createElement('article');
        artigo.className = 'cartao';
        artigo.dataset.revelar = '';
        artigo.dataset.atraso = String(
          estado.repositorios.dados.itens.indexOf(item) * 60,
        );

        const titulo = document.createElement('h3');
        titulo.className = 'cartao__nome';
        const link = document.createElement('a');
        link.href = item.url;
        link.rel = 'noopener noreferrer';
        link.target = '_blank';
        link.textContent = item.nome;
        titulo.append(link);
        artigo.append(titulo);

        if (item.descricao) {
          const p = document.createElement('p');
          p.className = 'cartao__resumo';
          p.textContent = item.descricao;
          artigo.append(p);
        }

        const meta = document.createElement('p');
        meta.className = 'cartao__meta';

        if (item.linguagem) {
          const span = document.createElement('span');
          span.className = 'cartao__lingua';
          span.textContent = item.linguagem;
          meta.append(span);
        }

        if (item.estrelas > 0) {
          const span = document.createElement('span');
          span.className = 'cartao__estrelas';
          span.textContent = `★ ${item.estrelas}`;
          meta.append(span);
        }

        const data = formatarMesAno(item.ultimoEnvio, textos.meses);
        if (data) {
          const tempo = document.createElement('time');
          tempo.dateTime = data.datetime;
          tempo.textContent = data.rotulo;
          meta.append(tempo);
        }

        if (meta.childElementCount > 0) artigo.append(meta);
        grade.append(artigo);
      }

      repos.append(grade);
      document.dispatchEvent(new CustomEvent('motion:alvos-novos'));
      if (estado.repositorios.dados.incompleto) aviso(repos, t.incompleto);
    }
    concluir(repos);
  }

  if (calendario) {
    if (!estado.calendario.ok || !estado.indicadores) {
      aviso(
        calendario,
        textoFalha(estado.calendario.ok ? 'rede' : estado.calendario.motivo),
      );
    } else {
      const dias = estado.calendario.dados;

      const periodo = document.createElement('p');
      periodo.className = 'calendario__periodo';
      const inicio = document.createElement('time');
      inicio.dateTime = dias[0].data;
      inicio.textContent = dias[0].data;
      const fim = document.createElement('time');
      fim.dateTime = dias[dias.length - 1].data;
      fim.textContent = dias[dias.length - 1].data;
      const legenda = document.createElement('span');
      legenda.className = 'calendario__hoje';
      legenda.textContent = t.hoje;

      const marca = document.createElement('i');
      marca.setAttribute('aria-hidden', 'true');
      legenda.append(marca);

      periodo.append(`${t.periodo}: `, inicio, ' — ', fim, legenda);

      const hojeLocal = (() => {
        const agora = new Date();
        const mes = String(agora.getMonth() + 1).padStart(2, '0');
        const dia = String(agora.getDate()).padStart(2, '0');
        return `${agora.getFullYear()}-${mes}-${dia}`;
      })();

      const lista = document.createElement('ol');
      lista.className = 'calendario';
      for (const dia of alinharSemana(dias)) {
        const li = document.createElement('li');
        li.className = 'calendario__dia';
        if (dia === null) {
          li.dataset.vazio = 'sim';
          li.setAttribute('aria-hidden', 'true');
        } else {
          li.dataset.nivel = String(dia.nivel);
          if (dia.data === hojeLocal) li.dataset.hoje = 'sim';
          li.setAttribute('aria-label', `${dia.data}: ${dia.contagem}`);
        }
        lista.append(li);
      }
      const ind = estado.indicadores;

      const total = secao.querySelector<HTMLElement>('.resumo__total');
      const valorTotal = total?.querySelector<HTMLElement>('[data-total]');
      const dl = secao.querySelector<HTMLDListElement>('[data-indicadores]');

      if (valorTotal) valorTotal.textContent = String(ind.total);

      const pares: [string, string][] = [
        [t.indicadores.diasAtivos, String(ind.diasAtivos)],
        [t.indicadores.sequenciaAtual, String(ind.sequenciaAtual)],
        [t.indicadores.maiorSequencia, String(ind.maiorSequencia)],
        [
          t.indicadores.melhorDia,
          ind.melhorDia
            ? `${ind.melhorDia.data} · ${ind.melhorDia.contagem}`
            : t.semContribuicoes,
        ],
      ];

      if (dl) {
        for (const [rotulo, valor] of pares) {
          const div = document.createElement('div');
          const dt = document.createElement('dt');
          dt.textContent = rotulo;
          const dd = document.createElement('dd');
          dd.textContent = valor;
          div.append(dt, dd);
          dl.append(div);
        }
        dl.removeAttribute('hidden');
      }

      const diferenca = indicadoresAnteriores
        ? seloDeDiferenca(ind.total, indicadoresAnteriores.total)
        : null;

      if (diferenca !== null && !reduzido && total) {
        const selo = document.createElement('span');
        selo.className = 'selo';
        selo.setAttribute('aria-hidden', 'true');
        selo.textContent = `+${diferenca}`;
        total.append(selo);
      }

      if (indicadoresAnteriores && !reduzido && valorTotal && dl) {
        if (indicadoresAnteriores.total !== ind.total) {
          valorTotal.classList.add('pulso');
        }

        const mudou = [
          indicadoresAnteriores.diasAtivos !== ind.diasAtivos,
          indicadoresAnteriores.sequenciaAtual !== ind.sequenciaAtual,
          indicadoresAnteriores.maiorSequencia !== ind.maiorSequencia,
          String(indicadoresAnteriores.melhorDia?.data) !==
            String(ind.melhorDia?.data),
        ];

        [...dl.querySelectorAll('dd')].forEach((dd, i) => {
          if (mudou[i]) dd.classList.add('pulso');
        });
      }

      const cartaoCalendario = document.createElement('div');
      cartaoCalendario.className = 'calendario__cartao';
      cartaoCalendario.append(periodo, lista);

      calendario.append(cartaoCalendario);
      lista.scrollLeft = lista.scrollWidth;
    }
    concluir(calendario);
  }
</script>
