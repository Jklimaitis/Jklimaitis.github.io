---
import type { CasoResumo } from '../dados/casos.mts';

interface Props {
  casos: CasoResumo[];
  rotuloAcao: string;
}

const { casos, rotuloAcao } = Astro.props;
---

<ul class="lista">
  {casos.map((caso) => (
    <li>
      <a class="cartao" href={caso.href}>
        <p class="tags">{caso.tags.join(' · ')}</p>
        <h3>{caso.titulo}</h3>
        <p class="resumo">{caso.resumo}</p>
        <span class="acao">{rotuloAcao} →</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .lista {
    max-width: 46rem;
    display: grid;
    gap: 1rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .cartao {
    display: block;
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    color: inherit;
    transition:
      border-color 140ms ease,
      transform 140ms ease;
  }

  .cartao:hover,
  .cartao:focus-visible {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .tags {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  h3 {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: 1.1875rem;
    line-height: 1.25;
  }

  .resumo {
    max-width: none;
    margin: 0 0 0.875rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .acao {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--accent);
  }
</style>
