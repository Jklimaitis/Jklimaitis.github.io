---
// Componente sem marcação: liga o modo animado, divide o título em palavras
// e observa os alvos de revelação. Tudo depende da classe `anim` no <html>,
// colocada apenas por JavaScript: sem script, nada nasce invisível.
---

<script>
  import { deslocamentoDoPonteiro } from '../dados/motion.mts';

  const reduzido = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (!reduzido.matches) {
    const raiz = document.documentElement;
    raiz.classList.add('anim');

    const observados = new Set<Element>();

    const observador = new IntersectionObserver(
      (entradas) => {
        for (const entrada of entradas) {
          if (!entrada.isIntersecting) continue;
          entrada.target.classList.add('in');
          observador.unobserve(entrada.target);
          observados.delete(entrada.target);
        }
      },
      { threshold: 0.15 },
    );

    const observar = () => {
      for (const alvo of document.querySelectorAll<HTMLElement>(
        '[data-revelar]',
      )) {
        if (observados.has(alvo) || alvo.classList.contains('in')) continue;

        const atraso = alvo.dataset.atraso;
        if (atraso && Number.isFinite(Number(atraso))) {
          alvo.style.setProperty('--d', `${Number(atraso)}ms`);
        }

        observados.add(alvo);
        observador.observe(alvo);
      }
    };

    // Alvos que nascem depois do carregamento, como os cartões do GitHub
    document.addEventListener('motion:alvos-novos', observar);

    const titulo = document.querySelector<HTMLElement>('#inicio h1');
    if (titulo) {
      const palavras = (titulo.textContent ?? '')
        .trim()
        .split(/\s+/)
        .filter(Boolean);

      titulo.textContent = '';
      titulo.classList.add('titulo-in');

      palavras.forEach((palavra, i) => {
        const mascara = document.createElement('span');
        mascara.className = 'palavra';
        mascara.style.setProperty('--i', String(i));

        const interna = document.createElement('span');
        interna.textContent = palavra;
        mascara.append(interna);
        titulo.append(mascara);

        if (i < palavras.length - 1) {
          titulo.append(document.createTextNode(' '));
        }
      });

      requestAnimationFrame(() => titulo.classList.add('in'));
    }

    observar();

    // Progresso de leitura e seção ativa do menu
    const barra = document.querySelector<HTMLElement>('[data-progresso]');
    const elos = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('nav a[href^="#"]'),
    );
    const secoes = elos
      .map((elo) => {
        const alvo = document.querySelector<HTMLElement>(
          elo.getAttribute('href') ?? '',
        );
        return alvo ? { elo, alvo } : null;
      })
      .filter(
        (par): par is { elo: HTMLAnchorElement; alvo: HTMLElement } =>
          par !== null,
      );

    let quadroRolagem = 0;

    const atualizarRolagem = () => {
      quadroRolagem = 0;

      const altura = document.documentElement.scrollHeight - window.innerHeight;
      const proporcao =
        altura > 0 ? Math.min(1, Math.max(0, window.scrollY / altura)) : 0;
      if (barra) barra.style.transform = `scaleX(${proporcao})`;

      if (secoes.length === 0) return;

      const limite = window.innerHeight * 0.35;
      const raiz = document.documentElement;
      // A ultima secao pode ser curta demais para cruzar o limiar: no fim
      // do documento ela assume, senao nunca chega a ficar ativa.
      const noFim =
        window.innerHeight + window.scrollY >= raiz.scrollHeight - 2;

      let ativa: (typeof secoes)[number] | null = null;
      for (const par of secoes) {
        if (par.alvo.getBoundingClientRect().top <= limite) ativa = par;
      }
      if (noFim) ativa = secoes[secoes.length - 1] ?? null;

      for (const par of secoes) {
        if (par === ativa) par.elo.setAttribute('aria-current', 'true');
        else par.elo.removeAttribute('aria-current');
      }
    };

    const agendarRolagem = () => {
      if (!quadroRolagem)
        quadroRolagem = requestAnimationFrame(atualizarRolagem);
    };

    window.addEventListener('scroll', agendarRolagem, { passive: true });
    window.addEventListener('resize', agendarRolagem, { passive: true });
    atualizarRolagem();

    // Cursos: o resumo abre no hover, sem tirar o controle nativo do summary
    if (window.matchMedia('(hover: hover)').matches) {
      for (const item of document.querySelectorAll<HTMLDetailsElement>(
        'details.cursos__item',
      )) {
        item.addEventListener('pointerenter', () => {
          item.open = true;
        });
        item.addEventListener('pointerleave', () => {
          item.open = false;
        });
      }
    }

    // Holofote: só onde existe ponteiro fino e de verdade
    const ponteiroFino = window.matchMedia(
      '(hover: hover) and (pointer: fine)',
    );

    if (ponteiroFino.matches) {
      let emFoco: HTMLElement | null = null;
      let quadro = 0;
      let pendente: { alvo: HTMLElement; x: number; y: number } | null = null;

      const pintar = () => {
        quadro = 0;
        if (!pendente) return;

        const { alvo, x, y } = pendente;
        pendente = null;

        const caixa = alvo.getBoundingClientRect();
        const ponto = deslocamentoDoPonteiro(x, y, caixa);
        alvo.style.setProperty('--mx', `${ponto.x}%`);
        alvo.style.setProperty('--my', `${ponto.y}%`);
      };

      const soltar = () => {
        if (emFoco) emFoco.classList.remove('ponta');
        emFoco = null;
      };

      document
        .querySelector('main')
        ?.addEventListener('pointermove', (evento) => {
          const alvo = (
            evento.target as HTMLElement | null
          )?.closest<HTMLElement>(
            '.cartao, .painel, .calendario__cartao, .indicadores, .stack__grupo, .linha__item',
          );
          if (!alvo) {
            soltar();
            return;
          }

          if (alvo !== emFoco) {
            soltar();
            alvo.classList.add('ponta');
            emFoco = alvo;
          }

          pendente = { alvo, x: evento.clientX, y: evento.clientY };
          if (!quadro) quadro = requestAnimationFrame(pintar);
        });

      document.querySelector('main')?.addEventListener('pointerleave', soltar);
    }
  }
</script>
