---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/manrope';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Github from './Github.astro';
import Motion from './Motion.astro';
import Projetos from './Projetos.astro';
import type { Dicionario } from '../i18n/types';

interface Props {
  d: Dicionario;
}

const { d } = Astro.props;
---

<html lang={d.idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{d.titulo}</title>
  </head>
  <body>
    <header>
      <nav aria-label={d.navRotulo}>
        {d.nav.map((item) => (
          <a href={item.href}>{item.rotulo}</a>
        ))}
      </nav>
      <a
        class="idioma"
        href={d.troca.href}
        hreflang={d.troca.idioma}
        lang={d.troca.idioma}
        aria-label={d.troca.rotuloAcessivel}
      >
        {d.troca.rotulo}
      </a>
    </header>

    <main>
      <section id="inicio">
        <h1>{d.inicio.nome}</h1>
        <p class="lead">{d.inicio.lead}</p>
        <div class="ctas">
          {d.inicio.acoes.map((acao) => (
            <a class={`cta cta--${acao.variante}`} href={acao.href}>
              {acao.rotulo}
            </a>
          ))}
        </div>
      </section>

      <section id="stack">
        <h2>{d.stack.titulo}</h2>
        <div class="stack">
          {d.stack.grupos.map((grupo) => (
            <div class="stack__grupo">
              <h3>{grupo.nome}</h3>
              <p>{grupo.itens.join(', ')}</p>
            </div>
          ))}
          <div class="stack__grupo stack__grupo--estudando">
            <h3>{d.stack.estudoTitulo}</h3>
            <p>{d.stack.estudo.join(', ')}</p>
          </div>
        </div>
      </section>

      <Projetos d={d} />

      <Github d={d} />

      <section id="trajetoria">
        <h2>{d.trajetoria.titulo}</h2>
        <ol class="linha">
          {d.trajetoria.experiencias.map((exp) => (
            <li class="linha__item">
              <div class="linha__topo">
                <h3>{exp.cargo}</h3>
                <p class="linha__periodo">{exp.periodo}</p>
              </div>
              <p class="linha__empresa">{exp.empresa}</p>
              <ul class="linha__itens">
                {exp.itens.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </li>
          ))}
        </ol>

        <h3 class="bloco__titulo">{d.trajetoria.cursosTitulo}</h3>
        <ul class="lista">
          {d.trajetoria.cursos.map((c) => (
            <li>
              <strong>{c.nome}</strong>, {c.instituicao}
            </li>
          ))}
        </ul>

        <h3 class="bloco__titulo">{d.trajetoria.idiomasTitulo}</h3>
        <p>{d.trajetoria.idiomas}</p>
      </section>

      <section id="contato">
        <h2>{d.contato.titulo}</h2>
        <p>{d.contato.texto}</p>
        <div class="ctas">
          {d.contato.acoes.map((acao) => (
            <a class={`cta cta--${acao.variante}`} href={acao.href}>
              {acao.rotulo}
            </a>
          ))}
        </div>
      </section>
    </main>

    <footer>
      <p>{d.rodape}</p>
    </footer>

    <Motion />
  </body>
</html>
