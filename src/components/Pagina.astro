---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/manrope';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Github from './Github.astro';
import Motion from './Motion.astro';
import Numeros from './Numeros.astro';
import Eventos from './Eventos.astro';
import Projetos from './Projetos.astro';
import type { Dicionario } from '../i18n/types';

interface Props {
  d: Dicionario;
}

const { d } = Astro.props;
---

<html lang={d.idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{d.titulo}</title>
  </head>
  <body>
    <span class="progresso" data-progresso aria-hidden="true"></span>

    <header>
      <div class="faixa">
        <a class="marca" href="#inicio">
          {d.inicio.nome}
        </a>

        <nav aria-label={d.navRotulo}>
          {d.nav.map((item) => (
            <a href={item.href}>{item.rotulo}</a>
          ))}
        </nav>
        <a
          class="idioma"
          href={d.troca.href}
          hreflang={d.troca.idioma}
          lang={d.troca.idioma}
          aria-label={d.troca.rotuloAcessivel}
        >
          {d.troca.rotulo}
        </a>
      </div>
    </header>

    <section id="inicio">
      <div class="abertura__meta">
        <p class="abertura__local">
          {d.inicio.meta.local}
          <span class="abertura__hora" data-hora></span>
        </p>
        <a class="abertura__perfil" href={d.inicio.meta.perfilHref}>
          {d.inicio.meta.perfilRotulo}
          <span aria-hidden="true"> ↗</span>
        </a>
      </div>

      <p class="abertura__nome">{d.inicio.nome}</p>

      <div class="abertura__grade">
        <div class="abertura__principal">
          <h1>
            <span class="abertura__antes">{d.inicio.oficio.antes}</span>{' '}
            <span class="ambar">{d.inicio.oficio.destaque}</span>
          </h1>

          <div class="ctas">
            {d.inicio.acoes.map((acao) => (
              <a class={`cta cta--${acao.variante}`} href={acao.href}>
                {acao.rotulo}
              </a>
            ))}
          </div>
        </div>

        <div class="abertura__lado">
          {d.inicio.posicao.map((texto) => (
            <p class="lead">{texto}</p>
          ))}
        </div>
      </div>

      <Numeros d={d} />

      <p class="abertura__rolar" aria-hidden="true">
        {d.inicio.rolar}
        <span class="abertura__seta">↓</span>
      </p>
    </section>

    <Eventos d={d} />

    <main>
      <section id="stack">
        <h2 data-revelar>{d.stack.titulo}</h2>
        <div class="stack">
          {d.stack.grupos.map((grupo) => (
            <div class="stack__grupo">
              <h3>{grupo.nome}</h3>
              {grupo.descricao && (
                <p class="stack__descricao">{grupo.descricao}</p>
              )}
              <ul class="chips">
                {grupo.itens.map((item) => (
                  <li class="chips__item">{item}</li>
                ))}
              </ul>
            </div>
          ))}
          <div class="stack__grupo stack__grupo--estudando">
            <h3>{d.stack.estudoTitulo}</h3>
            <p class="stack__descricao">{d.stack.estudoDescricao}</p>
            <ul class="chips">
              {d.stack.estudo.map((item) => (
                <li class="chips__item">{item}</li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <Projetos d={d} />

      <Github d={d} />

      <section id="trajetoria">
        <h2 data-revelar>{d.trajetoria.titulo}</h2>
        <ol class="linha">
          {d.trajetoria.experiencias.map((exp) => (
            <li class="linha__item">
              <div class="linha__topo">
                <h3>{exp.cargo}</h3>
                <p class="linha__periodo">{exp.periodo}</p>
              </div>
              <p class="linha__empresa">{exp.empresa}</p>
              {exp.itens.length > 0 && (
                <ul class="linha__itens">
                  {exp.itens.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ol>

        <h3 class="bloco__titulo">{d.trajetoria.cursosTitulo}</h3>
        <ul class="cursos">
          {d.trajetoria.cursos.map((c) => (
            <li>
              <details class="cursos__item">
                <summary class="cursos__topo">
                  <span class="cursos__nome">{c.nome}</span>
                  <span class="cursos__instituicao">{c.instituicao}</span>
                </summary>
                {c.resumo && <p class="cursos__resumo">{c.resumo}</p>}
              </details>
            </li>
          ))}
        </ul>

        <h3 class="bloco__titulo">{d.trajetoria.idiomasTitulo}</h3>
        <ul class="idiomas">
          {d.trajetoria.idiomas.map((i) => (
            <li class="idiomas__item">
              <span
                class="idiomas__bandeira"
                data-bandeira={i.bandeira}
                aria-hidden="true"
              />
              <span class="idiomas__nome">{i.nome}</span>
              <span class="idiomas__nivel">{i.nivel}</span>
            </li>
          ))}
        </ul>
      </section>

      <section id="contato">
        <h2 data-revelar>{d.contato.titulo}</h2>
        <p>{d.contato.texto}</p>
        <div class="ctas">
          {d.contato.acoes.map((acao) => (
            <a class={`cta cta--${acao.variante}`} href={acao.href}>
              {acao.rotulo}
            </a>
          ))}
        </div>
      </section>
    </main>

    <footer>
      <p>{d.rodape}</p>
    </footer>

    <Motion />
  </body>
</html>
